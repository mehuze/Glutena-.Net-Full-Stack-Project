@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Kullanıcı Yönetimi</h3>
</div>

<table class="table table-bordered table-hover bg-white">
    <thead class="table-dark">
        <tr>
            <th>E-posta</th>
            <th>Rol</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    @{
                        var roles = ViewBag.UserRoles != null && ViewBag.UserRoles.ContainsKey(user.Id)
                        ? string.Join(", ", ViewBag.UserRoles[user.Id])
                        : "User";
                    }
                    @roles
                </td>
                <td>
                    @if (roles.Contains("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="User" asp-action="RemoveAdmin" asp-route-id="@user.Id"
                           class="btn btn-sm btn-warning"
                           onclick="return confirm('Admin rolünü kaldırmak istediğinize emin misiniz?')">
                            Admin Kaldır
                        </a>
                    }
                    else
                    {
                        <a asp-area="Admin" asp-controller="User" asp-action="MakeAdmin" asp-route-id="@user.Id"
                           class="btn btn-sm btn-success">
                            Admin Yap
                        </a>
                    }
                    <a asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@user.Id"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Kullanıcıyı silmek istediğinize emin misiniz?')">
                        Sil
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>