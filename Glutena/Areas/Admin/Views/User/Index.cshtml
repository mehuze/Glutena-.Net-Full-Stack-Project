@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Kullanıcı Yönetimi</h3>
    <span class="text-muted">Toplam @Model.Count() kullanıcı</span>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
}

<table class="table table-bordered table-hover bg-white">
    <thead class="table-dark">
        <tr>
            <th>E-posta</th>
            <th>Rol</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var roles = ViewBag.UserRoles != null && ViewBag.UserRoles.ContainsKey(user.Id)
            ? string.Join(", ", ViewBag.UserRoles[user.Id])
            : "User";
            bool isMe = user.Id == (string)ViewBag.CurrentUserId;

            <tr>
                <td>
                    @user.Email
                    @if (isMe)
                    {
                        <span class="badge bg-secondary ms-2">Siz</span>
                    }
                </td>
                <td>@roles</td>
                <td>
                    @if (isMe)
                    {
                        <span class="text-muted">Kendi hesabınızda işlem yapılamaz</span>
                    }
                    else
                    {
                        @if (roles.Contains("Admin"))
                        {
                            <a asp-area="Admin" asp-controller="User" asp-action="RemoveAdmin" asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning"
                               onclick="return confirm('Admin rolünü kaldırmak istediğinize emin misiniz?')">
                                Admin Kaldır
                            </a>
                        }
                        else
                        {
                            <a asp-area="Admin" asp-controller="User" asp-action="MakeAdmin" asp-route-id="@user.Id"
                               class="btn btn-sm btn-success"
                               onclick="return confirm('Bu kullanıcıya admin yetkisi vermek istediğinize emin misiniz?')">
                                Admin Yap
                            </a>
                        }
                        <a asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@user.Id"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Kullanıcıyı silmek istediğinize emin misiniz? Yorumları sitede kalır ama artık kimseye ait olmaz.')">
                            Sil
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>