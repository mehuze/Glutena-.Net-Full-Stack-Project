<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Glutena Admin</title>
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="d-flex">
        <!-- SIDEBAR -->
        <div class="bg-dark text-white p-3" style="width:250px; min-height:100vh;">
            <h4>Glutena Admin</h4>
            <hr />
            <ul class="nav flex-column">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link text-success fw-bold">🏠 Anasayfa</a>
                <hr style="border-color:rgba(255,255,255,0.2);" />
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link text-white fw-bold">📊 Özet</a>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="nav-link text-white">Ürünler</a>
                <a asp-area="Admin" asp-controller="Brand" asp-action="Index" class="nav-link text-white">Markalar</a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-link text-white">Kategoriler</a>
                <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="nav-link text-white">Blog</a>
                <a asp-area="Admin" asp-controller="ContentPage" asp-action="Index" class="nav-link text-white">Sayfa Yönetimi</a>
                <a asp-area="Admin" asp-controller="Experience" asp-action="Index" class="nav-link text-white">Deneyimler</a>
                <a asp-area="Admin" asp-controller="Blacklist" asp-action="Index" class="nav-link text-white">Kara Liste</a>
                <a asp-area="Admin" asp-controller="User" asp-action="Index" class="nav-link text-white">Kullanıcılar</a>
                <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="nav-link text-white">Mesajlar</a>
              
            </ul>
        </div>
        <!-- CONTENT -->
        <div class="p-4 w-100">
            @RenderBody()
        </div>
    </div>
    <script src="~/js/site-utils.js"></script>

</body>
</html>