@model List<Glutena.Models.Entities.ContactMessage>

@{
    var unreadCount = Model.Count(m => !m.IsRead);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>
        Mesajlar
        @if (unreadCount > 0)
        {
            <span class="badge bg-danger ms-2" style="font-size:14px;">@unreadCount yeni</span>
        }
    </h3>
    <span class="text-muted">Toplam @Model.Count mesaj</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">Henüz mesaj yok.</div>
}

@foreach (var msg in Model)
{
    <div class="card mb-3" style="@(msg.IsRead ? "" : "border-left:4px solid #2d6a4f;")">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <div>
                    <strong style="font-size:16px;">@msg.Name</strong>
                    <a href="mailto:@msg.Email" class="text-muted ms-2" style="text-decoration:none;">&lt;@msg.Email&gt;</a>
                    @if (!msg.IsRead)
                    {
                        <span class="badge bg-success ms-2">Yeni</span>
                    }
                </div>
                <small class="text-muted">@msg.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
            </div>

            <span class="badge @(msg.Subject == "Marka işbirliği" ? "bg-warning text-dark" : msg.Subject == "Hatalı bilgi bildirimi" ? "bg-danger" : "bg-secondary") mb-3">
                @msg.Subject
            </span>

            <p style="white-space:pre-line; margin-bottom:16px;">@msg.Message</p>

            <div class="d-flex gap-2 flex-wrap">
                <a href="mailto:@msg.Email?subject=@Uri.EscapeDataString("Glutena: " + msg.Subject)"
                   class="btn btn-sm btn-success">Yanıtla</a>

                <form asp-area="Admin" asp-controller="Message" asp-action="ToggleRead" asp-route-id="@msg.Id" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        @(msg.IsRead ? "Okunmadı yap" : "Okundu yap")
                    </button>
                </form>

                <form asp-area="Admin" asp-controller="Message" asp-action="Delete" asp-route-id="@msg.Id" method="post"
                      onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?')">
                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                </form>
            </div>
        </div>
    </div>
}