@model IEnumerable<Glutena.Models.Entities.Feature>
@{
    ViewData["Title"] = "Özellikler";
}

<!-- Header -->
<div style="background: linear-gradient(135deg, #1b4332, #40916c); padding: 60px 0; text-align:center;">
    <h1 style="color:white; font-weight:700;">Platform Özellikleri</h1>
    <p style="color:rgba(255,255,255,0.75);">
        <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.75); text-decoration:none;">Anasayfa</a> /
        Özellikler
    </p>
</div>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 style="font-weight:700; color:#1b4332;">Glutena Ne Sunar?</h2>
        <p style="color:#888; max-width:600px; margin:0 auto;">
            Glutensiz beslenmeyi kolaylaştıran tüm araçlar tek platformda.
        </p>
    </div>

    <!-- Platform Özellikleri -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div style="background:white; border-radius:16px; padding:28px; border:1px solid #eee; display:flex; gap:20px; align-items:flex-start;">
                <div style="background:#e9f5ee; width:50px; height:50px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:24px;">🔍</div>
                <div>
                    <h5 style="font-weight:700; color:#1b4332; margin-bottom:8px;">Gelişmiş Arama</h5>
                    <p style="color:#666; font-size:14px; margin:0;">Ürün adı, marka veya kategori ile anlık arama yapın. Binlerce ürün arasında saniyeler içinde bulun.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div style="background:white; border-radius:16px; padding:28px; border:1px solid #eee; display:flex; gap:20px; align-items:flex-start;">
                <div style="background:#e9f5ee; width:50px; height:50px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:24px;">⭐</div>
                <div>
                    <h5 style="font-weight:700; color:#1b4332; margin-bottom:8px;">Kullanıcı Yorumları</h5>
                    <p style="color:#666; font-size:14px; margin:0;">Gerçek kullanıcıların deneyimlerini okuyun, puan verin ve kendi deneyimlerinizi paylaşın.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div style="background:white; border-radius:16px; padding:28px; border:1px solid #eee; display:flex; gap:20px; align-items:flex-start;">
                <div style="background:#e9f5ee; width:50px; height:50px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:24px;">🏷️</div>
                <div>
                    <h5 style="font-weight:700; color:#1b4332; margin-bottom:8px;">Kategori Sistemi</h5>
                    <p style="color:#666; font-size:14px; margin:0;">Makarna, atıştırmalık, kahvaltılık gibi kategorilere göre ürünleri kolayca filtreleyin.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div style="background:white; border-radius:16px; padding:28px; border:1px solid #eee; display:flex; gap:20px; align-items:flex-start;">
                <div style="background:#e9f5ee; width:50px; height:50px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:24px;">🛒</div>
                <div>
                    <h5 style="font-weight:700; color:#1b4332; margin-bottom:8px;">Güvenli Alışveriş</h5>
