@{
    ViewData["Title"] = "Özet";
    var latestPending = ViewBag.LatestPending as List<Glutena.Models.Entities.Experience> ?? new();
    var latestMessages = ViewBag.LatestMessages as List<Glutena.Models.Entities.ContactMessage> ?? new();
}

<style>
    .stat-card {
        display: block;
        background: white;
        border: 1px solid #eee;
        border-radius: 14px;
        padding: 20px;
        text-decoration: none;
        color: #222;
        height: 100%;
        transition: transform .15s, box-shadow .15s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
            color: #222;
        }

    .stat-icon {
        font-size: 26px;
        margin-bottom: 6px;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 700;
        line-height: 1.1;
    }

    .stat-label {
        color: #777;
        font-size: 14px;
    }

    .stat-alert {
        border-left: 4px solid #ffc107;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="m-0">📊 Özet</h3>
    <span class="text-muted">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
</div>

<!-- Yapılacak işler -->
<h6 class="text-muted mb-3">Bekleyen işler</h6>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
        <a asp-area="Admin" asp-controller="Experience" asp-action="Index"
           class="stat-card @(ViewBag.PendingExperiences > 0 ? "stat-alert" : "")">
            <div class="stat-icon">⏳</div>
            <div class="stat-number">@ViewBag.PendingExperiences</div>
            <div class="stat-label">Onay bekleyen deneyim</div>
        </a>
    </div>
    <div class="col-6 col-lg-4">
        <a asp-area="Admin" asp-controller="Experience" asp-action="Index"
           class="stat-card @(ViewBag.UnansweredExperiences > 0 ? "stat-alert" : "")">
            <div class="stat-icon">❓</div>
            <div class="stat-number">@ViewBag.UnansweredExperiences</div>
            <div class="stat-label">Yanıt bekleyen deneyim</div>
        </a>
    </div>
    <div class="col-6 col-lg-4">
        <a asp-area="Admin" asp-controller="Message" asp-action="Index"
           class="stat-card @(ViewBag.UnreadMessages > 0 ? "stat-alert" : "")">
            <div class="stat-icon">✉️</div>
            <div class="stat-number">@ViewBag.UnreadMessages</div>
            <div class="stat-label">Okunmamış mesaj</div>
        </a>
    </div>
</div>

<!-- Genel sayılar -->
<h6 class="text-muted mb-3">Genel durum</h6>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Experience" asp-action="Index" class="stat-card">
            <div class="stat-icon">💬</div>
            <div class="stat-number">@ViewBag.TotalExperiences</div>
            <div class="stat-label">Toplam deneyim</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Experience" asp-action="Index" class="stat-card">
            <div class="stat-icon">🌿</div>
            <div class="stat-number">@ViewBag.RepliedExperiences</div>
            <div class="stat-label">Yanıtladıklarım</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="stat-card">
            <div class="stat-icon">👤</div>
            <div class="stat-number">@ViewBag.TotalUsers</div>
            <div class="stat-label">Toplam üye</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-number">@ViewBag.TotalProducts</div>
            <div class="stat-label">Toplam ürün</div>
        </a>
    </div>
</div>

<!-- Son bekleyenler -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold">⏳ Onay bekleyen son deneyimler</div>
            <ul class="list-group list-group-flush">
                @if (!latestPending.Any())
                {
                    <li class="list-group-item text-muted">Onay bekleyen deneyim yok. 👍</li>
                }
                @foreach (var e in latestPending)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong>@e.Title</strong>
                            <small class="text-muted">@e.CreatedDate.ToString("dd.MM HH:mm")</small>
                        </div>
                        <small class="text-muted">@e.Product?.ProductName</small>
                    </li>
                }
            </ul>
            <div class="card-footer bg-white">
                <a asp-area="Admin" asp-controller="Experience" asp-action="Index">Tümünü gör →</a>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold">✉️ Okunmamış son mesajlar</div>
            <ul class="list-group list-group-flush">
                @if (!latestMessages.Any())
                {
                    <li class="list-group-item text-muted">Okunmamış mesaj yok. 👍</li>
                }
                @foreach (var m in latestMessages)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong>@m.Name</strong>
                            <small class="text-muted">@m.CreatedDate.ToString("dd.MM HH:mm")</small>
                        </div>
                        <small class="text-muted">@m.Subject</small>
                    </li>
                }
            </ul>
            <div class="card-footer bg-white">
                <a asp-area="Admin" asp-controller="Message" asp-action="Index">Tümünü gör →</a>
            </div>
        </div>
    </div>
</div>