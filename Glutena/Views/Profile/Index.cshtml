@model IEnumerable<Glutena.Models.Entities.Experience>
@{
    ViewData["Title"] = "Profilim";
}

<!-- Header -->
<div style="background: linear-gradient(135deg, #1b4332, #40916c); padding: 60px 0; text-align:center;">
    <h1 style="color:white; font-weight:700;">Profilim</h1>
    <p style="color:rgba(255,255,255,0.75);">
        <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.75); text-decoration:none;">Anasayfa</a> / Profilim
    </p>
</div>

<div class="container py-5">

    <!-- Hesap Bilgileri -->
    <div style="background:white; border-radius:16px; padding:30px; border:1px solid #eee; margin-bottom:24px;">
        <h4 style="color:#1b4332; font-weight:700; margin-bottom:16px;">Hesap Bilgilerim</h4>
        <div style="display:flex; gap:12px;">
            <span style="color:#888; width:120px;">E-posta</span>
            <span style="font-weight:600; color:#222;">@ViewBag.Email</span>
        </div>
        <div style="display:flex; gap:12px; margin-top:8px;">
            <span style="color:#888; width:120px;">Yorum Sayısı</span>
            <span style="font-weight:600; color:#222;">@Model.Count()</span>
        </div>
    </div>

    <!-- Yorumlarım -->
    <div style="background:white; border-radius:16px; padding:30px; border:1px solid #eee;">
        <h4 style="color:#1b4332; font-weight:700; margin-bottom:20px;">Yorumlarım</h4>

        @if (!Model.Any())
        {
            <p style="color:#aaa;">Henüz yorum yapmadınız.</p>
            <a asp-controller="Product" asp-action="Index"
               style="background:#1b4332; color:white; padding:10px 24px; border-radius:8px; text-decoration:none; font-weight:600; display:inline-block;">
                Ürünlere Göz At
            </a>
        }
        else
        {
            foreach (var exp in Model)
            {
                <div style="border:1px solid #eee; border-radius:12px; padding:20px; margin-bottom:16px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@exp.ProductId"
                           style="font-weight:700; color:#1b4332; text-decoration:none;">
                            @exp.Product?.ProductName
                        </a>
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            @if (!string.IsNullOrEmpty(exp.AdminReply))
                            {
                                <span style="background:#e9f5ee; color:#1b4332; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">🌿 Yanıtlandı</span>
                            }
                            @if (exp.IsApproved)
                            {
                                <span style="background:#d4edda; color:#155724; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">✅ Yayında</span>
                            }
                            else
                            {
                                <span style="background:#fff3cd; color:#856404; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">⏳ Onay Bekliyor</span>
                            }
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                        <h6 style="font-weight:700; color:#222; margin:0;">@exp.Title</h6>
                        <span style="color:#f4a261;">@string.Concat(Enumerable.Repeat("★", exp.Rating))</span>
                    </div>
                    <p style="color:#555; margin:0 0 8px 0;">@exp.Content</p>
                    <small style="color:#aaa;">@exp.CreatedDate.ToString("dd.MM.yyyy")</small>

                    @* Glutena yanıtı: sadece yanıt yazılmışsa görünür *@
                    @if (!string.IsNullOrEmpty(exp.AdminReply))
                    {
                        <div style="background:#f3faf6; border-left:3px solid #2d6a4f; border-radius:8px; padding:12px 16px; margin-top:14px;">
                            <div style="font-weight:700; color:#1b4332; font-size:14px; margin-bottom:4px;">
                                🌿 Glutena yanıtı
                                @if (exp.AdminReplyDate != null)
                                {
                                    <small style="color:#999; font-weight:400; margin-left:6px;">@exp.AdminReplyDate.Value.ToString("dd.MM.yyyy")</small>
                                }
                            </div>
                            <p style="color:#444; margin:0; font-size:14px; white-space:pre-line;">@exp.AdminReply</p>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>