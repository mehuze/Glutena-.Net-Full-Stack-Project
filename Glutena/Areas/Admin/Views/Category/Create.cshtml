@model Glutena.Models.Entities.Category

<h3 class="mb-4">Yeni Kategori</h3>

<div class="card p-4" style="max-width:500px;">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Active" class="form-label"></label>
            <input asp-for="Active" class="form-check-input ms-2" type="checkbox" />
        </div>
        <button type="submit" class="btn btn-success">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">İptal</a>
    </form>
</div>