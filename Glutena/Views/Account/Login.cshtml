@{
    ViewData["Title"] = "Giriş Yap";
}

<div style="background: linear-gradient(135deg, #1b4332, #40916c); padding: 60px 0; text-align:center;">
    <h1 style="color:white; font-weight:700;">Giriş Yap</h1>
    <p style="color:rgba(255,255,255,0.75);">
        <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.75); text-decoration:none;">Anasayfa</a> / Giriş
    </p>
</div>

<div class="container py-5">
    <div style="max-width:450px; margin:0 auto;">
        <div style="background:white; border-radius:16px; padding:36px; border:1px solid #eee;">

            <h4 style="color:#1b4332; font-weight:700; margin-bottom:24px; text-align:center;">Hesabınıza Giriş Yapın</h4>

            @if (ViewBag.Error != null)
            {
                <div style="background:#f8d7da; border-radius:8px; padding:12px; margin-bottom:16px;">
                    <p style="color:#721c24; margin:0; font-size:14px;">⚠️ @ViewBag.Error</p>
                </div>
            }

            <form method="post" action="/Account/Login">
                <div class="mb-3">
                    <label style="font-weight:600; color:#444;">E-posta</label>
                    <input type="email" name="email" class="form-control" placeholder="ornek@mail.com" required />
                </div>
                <div class="mb-3">
                    <label style="font-weight:600; color:#444;">Şifre</label>
                    <input type="password" name="password" class="form-control" placeholder="Şifreniz" required />
                </div>
                <div class="mb-3">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <input type="checkbox" name="rememberMe" id="rememberMe" />
                        <label for="rememberMe" style="font-size:14px; color:#555; margin:0;">Beni Hatırla</label>
                    </div>
                </div>
                <button type="submit"
                        style="background:#1b4332; color:white; padding:12px; border-radius:8px; border:none; font-weight:700; width:100%; font-size:15px;">
                    Giriş Yap
                </button>
            </form>

            <div style="text-align:center; margin-top:20px;">
                <p style="color:#888; font-size:14px;">
                    Hesabınız yok mu?
                    <a href="/Account/Register" style="color:#1b4332; font-weight:600;">Kayıt Ol</a>
                </p>
            </div>
        </div>
    </div>
</div>