    <!-- İstatistikler -->
    <div style="background:#1b4332; border-radius:16px; padding:40px;">
        <div class="row g-4 text-center">
            <div class="col-lg-3 col-md-6">
                <div style="font-size:36px; font-weight:700; color:#95d5b2;">500+</div>
                <div style="font-size:14px; color:rgba(255,255,255,0.75); margin-top:4px;">Glutensiz Ürün</div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div style="font-size:36px; font-weight:700; color:#95d5b2;">1000+</div>
                <div style="font-size:14px; color:rgba(255,255,255,0.75); margin-top:4px;">Kullanıcı Yorumu</div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div style="font-size:36px; font-weight:700; color:#95d5b2;">50+</div>
                <div style="font-size:14px; color:rgba(255,255,255,0.75); margin-top:4px;">Marka</div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div style="font-size:36px; font-weight:700; color:#95d5b2;">%100</div>
                <div style="font-size:14px; color:rgba(255,255,255,0.75); margin-top:4px;">Güvenilir İçerik</div>
            </div>
        </div>
