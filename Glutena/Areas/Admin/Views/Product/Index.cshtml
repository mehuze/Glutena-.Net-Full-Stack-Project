@model IEnumerable<Glutena.Models.Entities.Product>

<div class="container mt-4">

    <h2>Ürün Yönetimi</h2>

    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-success">+ Yeni Ürün</a>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>ID</th>
                <th>Ürün Adı</th>
                <th>Fiyat</th>
                <th>Marka</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.ProductName</td>
                    <td>@item.Price</td>
                    <td>@item.Brand?.Name</td>

                    <td>

                        <a href="/Admin/Product/Edit/@item.Id"
                           class="btn btn-warning btn-sm">
                            Güncelle
                        </a>

                        <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Silmek istediğinize emin misiniz?')">
                            Sil
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>