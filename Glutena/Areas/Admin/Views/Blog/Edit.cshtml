@model Glutena.Models.Entities.Blog

<div class="container mt-4">
    <h2>Blog Güncelle</h2>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Başlık</label>
            <input asp-for="BlogName" class="form-control" />
            <span asp-validation-for="BlogName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">İçerik</label>
            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Mevcut Resim</label><br />
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" style="height:100px; object-fit:cover; border-radius:8px;" class="mb-2" />
            }
            <input type="file" name="photoFile" class="form-control" accept="image/*" />
            <small class="text-muted">Yeni resim seçmezseniz mevcut resim korunur.</small>
        </div>
        <div class="mb-3">
            <label asp-for="IsActive" class="form-label">Aktif</label>
            <input asp-for="IsActive" class="form-check-input ms-2" type="checkbox" />
        </div>
        <button type="submit" class="btn btn-warning">Güncelle</button>
        <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="btn btn-secondary ms-2">Geri</a>
    </form>
</div>