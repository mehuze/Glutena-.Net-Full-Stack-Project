@{
    ViewData["Title"] = "Ana Sayfa";
}


<!-- Hero Start -->
<div class="container-fluid bg-primary bg-hero mb-5">
    <div class="container py-5">
        <div class="row align-items-center py-5">

            <div class="col-lg-7 text-white">
                <h1 class="display-3 fw-bold mb-4">
                    Türkiye'nin En Güvenilir
                    <span class="text-warning">Glutensiz Ürün Rehberi</span>
                </h1>

                <p class="fs-5 mb-4">
                    Glutensiz ürünleri keşfedin, kullanıcı yorumlarını inceleyin
                    ve güvenle tüketin. Gerçek deneyimler, gerçek içerikler.
                </p>

                <a href="#" class="btn btn-light btn-lg rounded-pill px-5 me-3">
                    Ürünleri Keşfet
                </a>

                <a href="#" class="btn btn-outline-light btn-lg rounded-pill px-5">
                    Blog Yazıları
                </a>
            </div>

            <div class="col-lg-5 text-center">
                <img src="/img/glutena.png"
                     alt="Glutensiz Ürün"
                     style="width: 120%;" 
                     class="img-fluid"
                     alt="Glutensiz Ürün" />
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">

            <div class="col-lg-6">
                <img class="img-fluid w-100" src="~/img/about.jpg" alt="">
            </div>

            <div class="col-lg-6">
                <h1 class="display-5 mb-4">
                    Glutena Nedir?
                </h1>
                <p class="mb-4">
                    Glutena, glutensiz ürünleri keşfetmenizi, yorumlamanızı
                    ve güvenle tüketmenizi sağlayan bir rehber platformudur.
                </p>

                <a class="btn btn-primary rounded-pill py-3 px-5" href="#">
                    Daha Fazla
                </a>
            </div>

        </div>
    </div>
</div>
<!-- About End -->
<!-- Products Preview Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5" style="max-width: 500px;">
            <h1 class="display-5 mb-3">Öne Çıkan Ürünler</h1>
            <p>En çok görüntülenen ve güvenilen glutensiz ürünler.</p>
        </div>

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="product-item bg-light p-4 text-center">
                    <img class="img-fluid mb-3" src="~/img/product-1.jpg" alt="">
                    <h5>Glutensiz Ekmek</h5>
                    <span class="text-primary">₺45</span>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="product-item bg-light p-4 text-center">
                    <img class="img-fluid mb-3" src="~/img/product-2.jpg" alt="">
                    <h5>Glutensiz Makarna</h5>
                    <span class="text-primary">₺39</span>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="product-item bg-light p-4 text-center">
                    <img class="img-fluid mb-3" src="~/img/product-3.jpg" alt="">
                    <h5>Glutensiz Atıştırmalık</h5>
                    <span class="text-primary">₺29</span>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="product-item bg-light p-4 text-center">
                    <img class="img-fluid mb-3" src="~/img/product-4.jpg" alt="">
                    <h5>Glutensiz Un</h5>
                    <span class="text-primary">₺55</span>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Products Preview End -->
<!-- Blog Preview Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5" style="max-width: 500px;">
            <h1 class="display-5 mb-3">Son Blog Yazıları</h1>
        </div>

        <div class="row g-4">

            <div class="col-lg-4">
                <img class="img-fluid" src="~/img/blog-1.jpg" alt="">
                <div class="bg-light p-4">
                    <h5>Glutensiz Beslenmeye Başlangıç</h5>
                </div>
            </div>

            <div class="col-lg-4">
                <img class="img-fluid" src="~/img/blog-2.jpg" alt="">
                <div class="bg-light p-4">
                    <h5>Market Alışverişinde Nelere Dikkat Etmeli?</h5>
                </div>
            </div>

            <div class="col-lg-4">
                <img class="img-fluid" src="~/img/blog-3.jpg" alt="">
                <div class="bg-light p-4">
                    <h5>En İyi Glutensiz Markalar</h5>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Blog Preview End -->