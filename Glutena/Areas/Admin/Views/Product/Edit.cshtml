@model Glutena.Models.Entities.Product
<div class="container mt-4">
    <h2>Ürün Güncelle</h2>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label>Ürün Adı</label>
            <input asp-for="ProductName" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Açıklama</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label>Gluten Durumu</label>
            <input asp-for="GlutenStatus" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Slug</label>
            <input asp-for="Slug" id="slugInput" class="form-control" readonly style="background:#f8f9fa;" />
            <small class="text-muted">Ürün adından otomatik oluşturulur.</small>
        </div>
        <div class="mb-3">
            <label>Fiyat</label>
            <input asp-for="Price" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Mevcut Resim</label><br />
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" style="height:100px; object-fit:cover; border-radius:8px;" class="mb-2" />
            }
            <input type="file" name="photoFile" class="form-control" accept="image/*" />
            <small class="text-muted">Yeni resim seçmezseniz mevcut resim korunur.</small>
        </div>
        <div class="mb-3">
            <label>Marka</label>
            <select asp-for="BrandId" class="form-control">
                <option value="">Seçiniz</option>
                @foreach (var brand in ViewBag.Brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label style="font-weight:600; color:#444;">Kategoriler</label>
            <div style="border:1px solid #dee2e6; border-radius:8px; padding:12px;">
                @foreach (var category in ViewBag.Categories)
                {
                    <div class="form-check">
                        <input type="checkbox"
                               name="categoryIds"
                               value="@category.Id"
                               class="form-check-input"
                               id="cat_@category.Id"
                               @(ViewBag.SelectedCategories != null && ((List<int>)ViewBag.SelectedCategories).Contains(category.Id) ? "checked" : "") />
                        <label class="form-check-label" for="cat_@category.Id">
                            @category.CategoryName
                        </label>
                    </div>
                }
            </div>
        </div>
        <button class="btn btn-success"
                onclick="return confirm('Güncellemek istediğinize emin misiniz?')">
            Güncelle
        </button>
        <a href="/Admin/Product/Index" class="btn btn-secondary">
            Geri
        </a>
    </form>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            bindSlugInput('ProductName', 'slugInput');
        });
    </script>
</div>