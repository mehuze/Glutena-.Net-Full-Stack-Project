@model IEnumerable<Glutena.Models.Entities.Experience>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Deneyim Yönetimi</h3>
</div>

<table class="table table-bordered table-hover bg-white">
    <thead class="table-dark">
        <tr>
            <th>Ürün</th>
            <th>Başlık</th>
            <th>Yorum</th>
            <th>Puan</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product?.ProductName</td>
                <td>@item.Title</td>
                <td>@item.Content</td>
                <td>@item.Rating / 5</td>
                <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (item.IsApproved)
                    {
                        <span class="badge bg-success">Onaylı</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Bekliyor</span>
                    }
                </td>
                <td>
                    @if (!item.IsApproved)
                    {
                        <a asp-area="Admin" asp-controller="Experience" asp-action="Approve" asp-route-id="@item.Id"
                           class="btn btn-sm btn-success">Onayla</a>
                    }
                    <a asp-area="Admin" asp-controller="Experience" asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
