@{
    ViewData["Title"] = "Kayıt Ol";
}

<div style="background: linear-gradient(135deg, #1b4332, #40916c); padding: 60px 0; text-align:center;">
    <h1 style="color:white; font-weight:700;">Kayıt Ol</h1>
    <p style="color:rgba(255,255,255,0.75);">
        <a href="/" style="color:rgba(255,255,255,0.75); text-decoration:none;">Anasayfa</a> / Kayıt
    </p>
</div>

<div class="container py-5">
    <div style="max-width:450px; margin:0 auto;">
        <div style="background:white; border-radius:16px; padding:36px; border:1px solid #eee;">

            <h4 style="color:#1b4332; font-weight:700; margin-bottom:24px; text-align:center;">Yeni Hesap Oluştur</h4>

            @if (ViewBag.Error != null)
            {
                <div style="background:#f8d7da; border-radius:8px; padding:12px; margin-bottom:16px;">
                    <p style="color:#721c24; margin:0; font-size:14px;">⚠️ @ViewBag.Error</p>
                </div>
            }

            <form method="post" action="/Account/Register">
                <div class="mb-3">
                    <label for="email" style="font-weight:600; color:#444;">E-posta</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="ornek@mail.com" required />
                </div>
                <div class="mb-3">
                    <label for="password" style="font-weight:600; color:#444;">Şifre</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Şifreniz" required minlength="6" />
                    <small style="color:#888;">En az 6 karakter ve en az 1 rakam içermeli.</small>
                </div>
                <div class="mb-3">
                    <label for="confirmPassword" style="font-weight:600; color:#444;">Şifre Tekrar</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" required />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" name="kvkkRead" value="true" id="kvkkRead" class="form-check-input" required />
                    <label for="kvkkRead" class="form-check-label" style="font-size:13px; color:#555;">
                        <a href="/sayfa/kvkk-aydinlatma-metni" target="_blank" style="color:#2d6a4f; font-weight:600;">KVKK Aydınlatma Metni</a>'ni okudum.
                    </label>
                </div>

                <button type="submit"
                        style="background:#1b4332; color:white; padding:12px; border-radius:8px; border:none; font-weight:700; width:100%; font-size:15px;">
                    Kayıt Ol
                </button>
            </form>

            <div style="text-align:center; margin-top:20px;">
                <p style="color:#888; font-size:14px;">
                    Zaten hesabınız var mı?
                    <a href="/Account/Login" style="color:#1b4332; font-weight:600;">Giriş Yap</a>
                </p>
            </div>
        </div>
    </div>
</div>