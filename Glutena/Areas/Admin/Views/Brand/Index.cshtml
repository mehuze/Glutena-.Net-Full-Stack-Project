@model List<Glutena.Models.Entities.Brand>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Markalar</h3>
    <a asp-area="Admin" asp-controller="Brand" asp-action="Create" class="btn btn-success">+ Yeni Marka</a>
</div>

<table class="table table-bordered table-hover bg-white">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Marka Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-area="Admin" asp-controller="Brand" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-area="Admin" asp-controller="Brand" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>