@model IEnumerable<Glutena.Models.Entities.BlacklistWord>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Kara Liste Yönetimi</h3>
</div>

<!-- Kelime Ekle -->
<div style="background:white; border-radius:12px; padding:24px; border:1px solid #eee; margin-bottom:24px;">
    <h5 style="color:#1b4332; font-weight:700; margin-bottom:16px;">Yeni Kelime Ekle</h5>
    <form asp-action="Add" method="post">
        <div style="display:flex; gap:12px;">
            <input type="text" name="word" class="form-control"
                   placeholder="Engellenecek kelimeyi yazın..." />
            <button type="submit" class="btn btn-danger" style="white-space:nowrap;">
                + Ekle
            </button>
        </div>
    </form>
</div>

<!-- Kelime Listesi -->
<table class="table table-bordered table-hover bg-white">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Kelime</th>
            <th>Eklenme Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Word</td>
                <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-area="Admin" asp-controller="Blacklist" asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>