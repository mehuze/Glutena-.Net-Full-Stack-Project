@{
    ViewData["Title"] = "İletişim";

    // ---- İletişim bilgileri: sadece buradan değiştir ----
    var email = "glutena.iletisim@gmail.com";
    var instagram = "glutena";   // Başında @ olmadan yaz
}

<style>
    .page-header {
        background: linear-gradient(135deg, #1b4332, #40916c) !important;
        padding: 60px 0;
        text-align: center;
    }

    .contact-card {
        background: white;
        border-radius: 14px;
        padding: 30px;
        border: 1px solid #eee;
    }

    .contact-icon {
        background: #e9f5ee;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #1b4332;
    }

    .contact-row {
        display: flex;
        gap: 14px;
        align-items: center;
    }

        .contact-row a {
            color: #2d6a4f;
            text-decoration: none;
            font-weight: 600;
            word-break: break-all;
        }

            .contact-row a:hover {
                text-decoration: underline;
            }
</style>

<!-- Header -->
<div class="page-header">
    <h1 style="color:white; font-weight:700;">İletişim</h1>
    <p style="color:rgba(255,255,255,0.75);">
        <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.75); text-decoration:none;">Anasayfa</a>
        / İletişim
    </p>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">

        <!-- Sol: Bilgiler -->
        <div class="col-lg-4">
            <div class="contact-card mb-4">
                <h4 style="color:#1b4332; font-weight:700; margin-bottom:8px;">Bize Ulaşın</h4>
                <p style="color:#666; font-size:15px; margin-bottom:24px;">
                    Soru, öneri ya da yanlış bulduğunuz bir ürün bilgisi için bize yazın.
                    Genellikle 2 iş günü içinde dönüş yapıyoruz.
                </p>

                <div class="contact-row" style="margin-bottom:18px;">
                    <div class="contact-icon"><i class="fa fa-envelope"></i></div>
                    <div>
                        <p style="font-weight:600; margin:0; color:#222;">E-posta</p>
                        <a href="mailto:@email">@email</a>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(instagram))
                {
                    <div class="contact-row">
                        <div class="contact-icon"><i class="fab fa-instagram"></i></div>
                        <div>
                            <p style="font-weight:600; margin:0; color:#222;">Instagram</p>
                            <a href="https://instagram.com/@instagram" target="_blank" rel="noopener">@("@" + instagram)</a>
                        </div>
                    </div>
                }
            </div>

            <!-- Marka işbirlikleri -->
            <div class="contact-card" style="background:#f3faf6; border-color:#d8f3dc;">
                <h5 style="color:#1b4332; font-weight:700; margin-bottom:10px;">Marka İşbirlikleri</h5>
                <p style="color:#555; font-size:14px; margin-bottom:12px;">
                    Glutensiz ürünlerinizi Glutena'da tanıtmak, ürün sayfanızı öne çıkarmak
                    ya da işbirliği yapmak için formda <strong>"Marka işbirliği"</strong> konusunu seçerek bize yazın.
                </p>
                <p style="color:#888; font-size:13px; margin:0;">
                    Sitede yer alan tüm ürünlerin gluten bilgileri, sponsorlu olsun ya da olmasın, aynı titizlikle kontrol edilir.
                </p>
            </div>
        </div>

        <!-- Sağ: Form -->
        <div class="col-lg-6">
            <div class="contact-card">
                <h4 style="color:#1b4332; font-weight:700; margin-bottom:24px;">Bize Yazın</h4>

                @if (TempData["Success"] != null)
                {
                    <div style="background:#d4edda; border-radius:8px; padding:12px; margin-bottom:16px;">
                        <p style="color:#155724; margin:0;">✅ @TempData["Success"]</p>
                    </div>
                }

                <form asp-controller="Home" asp-action="Contact" method="post">
                    <div class="mb-3">
                        <label for="Name" style="font-weight:600; color:#444;">Adınız</label>
                        <input type="text" id="Name" name="Name" class="form-control" placeholder="Adınızı girin" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="Email" style="font-weight:600; color:#444;">E-posta</label>
                        <input type="email" id="Email" name="Email" class="form-control" placeholder="Size dönüş yapacağımız adres" required maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label for="Subject" style="font-weight:600; color:#444;">Konu</label>
                        <select id="Subject" name="Subject" class="form-select" required>
                            <option value="Genel soru">Genel soru</option>
                            <option value="Ürün önerisi">Ürün önerisi</option>
                            <option value="Hatalı bilgi bildirimi">Hatalı ürün bilgisi bildirimi</option>
                            <option value="Marka işbirliği">Marka işbirliği</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="Message" style="font-weight:600; color:#444;">Mesajınız</label>
                        <textarea id="Message" name="Message" class="form-control" rows="5" placeholder="Mesajınızı yazın..." required maxlength="2000"></textarea>
                    </div>
                    <button type="submit" style="background:#1b4332; color:white; padding:12px 28px; border-radius:8px; border:none; font-weight:600; width:100%;">
                        Gönder
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>