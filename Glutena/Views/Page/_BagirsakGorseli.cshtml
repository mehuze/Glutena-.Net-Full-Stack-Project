@* Yeni Tanı Rehberi: sağlıklı ve çölyakta hasarlı ince bağırsak karşılaştırması.
   Bölüm metninde [bagirsak-gorseli] yazan yere Detail.cshtml tarafından yerleştirilir.
   Çizim Glutena'nın kendi tasarımıdır, temsilidir (ölçekli değildir). *@

<style>
    .cp-gut {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 20px 0 8px;
    }

    .cp-gut-panel {
        margin: 0;
        border-radius: 14px;
        overflow: hidden;
        border: 2px solid;
        background: #fdf6f3;
    }

    .cp-gut-ok {
        border-color: #95d5b2;
    }

    .cp-gut-bad {
        border-color: #f0b8a8;
    }

    .cp-gut-title {
        font-weight: 700;
        font-size: 16px;
        padding: 10px 14px;
    }

    .cp-gut-ok .cp-gut-title {
        background: #e9f5ee;
        color: #1b4332;
    }

    .cp-gut-bad .cp-gut-title {
        background: #fdece7;
        color: #8a2e1c;
    }

    .cp-gut-panel svg {
        display: block;
        width: 100%;
        height: auto;
    }

    .cp-gut-panel ul {
        list-style: none;
        padding: 10px 14px 12px !important;
        margin: 0;
        font-size: 14px;
    }

    .cp-gut-panel li {
        margin-bottom: 4px !important;
        line-height: 1.5 !important;
    }

    .cp-gut-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 6px;
        vertical-align: middle;
    }

    .cp-gut-caption {
        text-align: center;
        font-size: 13px;
        color: #888;
        margin: 0 0 16px;
    }

    @@media (max-width: 640px) {
        .cp-gut {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cp-gut">

    <!-- Sağlıklı bağırsak -->
    <figure class="cp-gut-panel cp-gut-ok">
        <figcaption class="cp-gut-title">✅ Sağlıklı ince bağırsak</figcaption>
        <svg viewBox="0 0 240 150" role="img" aria-label="Uzun ve sık tüycükleri olan sağlıklı ince bağırsak çizimi">
            <g fill="#f4a99c" stroke="#d9776b" stroke-width="1.5">
                <rect x="9" y="26" width="20" height="96" rx="10" />
                <rect x="37" y="20" width="20" height="102" rx="10" />
                <rect x="65" y="28" width="20" height="94" rx="10" />
                <rect x="93" y="22" width="20" height="100" rx="10" />
                <rect x="121" y="26" width="20" height="96" rx="10" />
                <rect x="149" y="20" width="20" height="102" rx="10" />
                <rect x="177" y="28" width="20" height="94" rx="10" />
                <rect x="205" y="22" width="20" height="100" rx="10" />
            </g>
            <g fill="#40916c">
                <circle cx="33" cy="60" r="3.5" />
                <circle cx="61" cy="90" r="3.5" />
                <circle cx="89" cy="55" r="3.5" />
                <circle cx="117" cy="80" r="3.5" />
                <circle cx="145" cy="62" r="3.5" />
                <circle cx="173" cy="95" r="3.5" />
                <circle cx="201" cy="70" r="3.5" />
            </g>
            <rect x="0" y="114" width="240" height="36" fill="#f3c1b8" />
            <path d="M0 136 H240" stroke="#c0392b" stroke-width="4" opacity="0.35" />
        </svg>
        <ul>
            <li>Tüycükler uzun ve sık</li>
            <li>Emilim yüzeyi geniş</li>
            <li><span class="cp-gut-dot" style="background:#40916c"></span>Besinler kana rahatça geçer</li>
        </ul>
    </figure>

    <!-- Çölyakta hasarlı bağırsak -->
    <figure class="cp-gut-panel cp-gut-bad">
        <figcaption class="cp-gut-title">⚠️ Çölyakta gluten yenince</figcaption>
        <svg viewBox="0 0 240 150" role="img" aria-label="Tüycükleri kısalmış ve yassılaşmış, hasarlı ince bağırsak çizimi">
            <g fill="#e0a100">
                <ellipse cx="40" cy="50" rx="7" ry="4" transform="rotate(-25 40 50)" />
                <ellipse cx="96" cy="72" rx="7" ry="4" transform="rotate(20 96 72)" />
                <ellipse cx="150" cy="44" rx="7" ry="4" transform="rotate(-10 150 44)" />
                <ellipse cx="200" cy="76" rx="7" ry="4" transform="rotate(30 200 76)" />
                <ellipse cx="124" cy="86" rx="6" ry="3.5" />
            </g>
            <g fill="#e8968a" stroke="#c4645a" stroke-width="1.5">
                <rect x="6" y="100" width="30" height="22" rx="9" />
                <rect x="40" y="104" width="34" height="18" rx="8" />
                <rect x="78" y="98" width="28" height="24" rx="9" />
                <rect x="110" y="105" width="36" height="17" rx="8" />
                <rect x="150" y="101" width="30" height="21" rx="9" />
                <rect x="184" y="104" width="50" height="18" rx="8" />
            </g>
            <g fill="#7b5ea7" opacity="0.85">
                <circle cx="58" cy="96" r="5" />
                <circle cx="128" cy="98" r="5" />
                <circle cx="208" cy="97" r="5" />
            </g>
            <rect x="0" y="114" width="240" height="36" fill="#f3c1b8" />
            <path d="M0 136 H240" stroke="#c0392b" stroke-width="4" opacity="0.35" />
        </svg>
        <ul>
            <li><span class="cp-gut-dot" style="background:#e0a100"></span>Gluten</li>
            <li><span class="cp-gut-dot" style="background:#7b5ea7"></span>Saldırıya geçen bağışıklık hücreleri</li>
            <li>Tüycükler kısalır ve yassılaşır, emilim azalır</li>
        </ul>
    </figure>

</div>
<p class="cp-gut-caption">Çizim temsilidir, gerçek ölçüleri göstermez.</p>