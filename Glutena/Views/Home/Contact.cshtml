@{
    ViewData["Title"] = "İletişim";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #1b4332, #40916c) !important;
        padding: 60px 0;
        text-align: center;
    }
</style>

<!-- Header -->
<div class="page-header">
    <h1 style="color:white; font-weight:700;">İletişim</h1>
    <p style="color:rgba(255,255,255,0.75);">
        <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.75); text-decoration:none;">Anasayfa</a>
        / İletişim
    </p>
</div>

<!-- İletişim -->
<div class="container py-5">
    <div class="row g-4 justify-content-center">

        <!-- Sol: Bilgiler -->
        <div class="col-lg-4">
            <div style="background:white; border-radius:14px; padding:30px; border:1px solid #eee; height:100%;">
                <h4 style="color:#1b4332; font-weight:700; margin-bottom:24px;">İletişim Bilgileri</h4>

                <div style="display:flex; gap:14px; margin-bottom:20px;">
                    <div style="background:#e9f5ee; width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <i class="fa fa-envelope" style="color:#1b4332;"></i>
                    </div>
                    <div>
                        <p style="font-weight:600; margin:0; color:#222;">E-posta</p>
                        <a href="mailto:info@glutena.com" style="color:#888; text-decoration:none;">info@glutena.com</a>
                    </div>
                </div>

                

                <!-- Sosyal Medya -->
                <h5 style="color:#1b4332; font-weight:700; margin-top:24px; margin-bottom:16px;">Sosyal Medya</h5>

                <div style="display:flex; gap:12px;">
                    <a href="https://instagram.com/glutena" target="_blank"
                       style="background:#e9f5ee; width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; text-decoration:none; transition:background 0.2s;"
                       onmouseover="this.style.background='#1b4332'" onmouseout="this.style.background='#e9f5ee'">
                        <i class="fab fa-instagram" style="color:#1b4332; font-size:18px;"></i>
                    </a>
                    <a href="https://twitter.com/glutena" target="_blank"
                       style="background:#e9f5ee; width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; text-decoration:none; transition:background 0.2s;"
                       onmouseover="this.style.background='#1b4332'" onmouseout="this.style.background='#e9f5ee'">
                        <i class="fab fa-twitter" style="color:#1b4332; font-size:18px;"></i>
                    </a>
                    <a href="https://facebook.com/glutena" target="_blank"
                       style="background:#e9f5ee; width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; text-decoration:none; transition:background 0.2s;"
                       onmouseover="this.style.background='#1b4332'" onmouseout="this.style.background='#e9f5ee'">
                        <i class="fab fa-facebook" style="color:#1b4332; font-size:18px;"></i>
                    </a>
                   
                </div>
            </div>
        </div>

        <!-- Sağ: Form -->
        <div class="col-lg-6">
            <div style="background:white; border-radius:14px; padding:30px; border:1px solid #eee;">
                <h4 style="color:#1b4332; font-weight:700; margin-bottom:24px;">Bize Yazın</h4>

                @if (TempData["Success"] != null)
                {
                    <div style="background:#d4edda; border-radius:8px; padding:12px; margin-bottom:16px;">
                        <p style="color:#155724; margin:0;">✅ @TempData["Success"]</p>
                    </div>
                }

                <form>
                    <div class="mb-3">
                        <label style="font-weight:600; color:#444;">Adınız</label>
                        <input type="text" class="form-control" placeholder="Adınızı girin" />
                    </div>
                    <div class="mb-3">
                        <label style="font-weight:600; color:#444;">E-posta</label>
                        <input type="email" class="form-control" placeholder="E-posta adresiniz" />
                    </div>
                    <div class="mb-3">
                        <label style="font-weight:600; color:#444;">Mesajınız</label>
                        <textarea class="form-control" rows="5" placeholder="Mesajınızı yazın..."></textarea>
                    </div>
                    <button type="submit" style="background:#1b4332; color:white; padding:12px 28px; border-radius:8px; border:none; font-weight:600; width:100%;">
                        Gönder
                    </button>
                    <small style="color:#aaa; display:block; margin-top:8px; text-align:center;">
                        📧 Domain alındıktan sonra mesajlar e-postanıza iletilecektir.
                    </small>
                </form>
            </div>
        </div>

    </div>

   
</div>